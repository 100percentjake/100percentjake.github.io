const SKU_GUID_TO_NAME=(()=>{
  const lines=FULL_SKU_TABLE.split('\n').map(l=>l.trim()).filter(Boolean);
  const map=Object.create(null);
  for(let i=1;i<lines.length;i++){
    const parts=lines[i].split(';');
    if(parts.length<3)continue;
    map[parts[2].trim().toLowerCase()]=parts[0].trim();
  }
  return map;
})();

const GUID_TO_PART=(()=>{
  const lines=FULL_SKU_TABLE.split('\n').map(l=>l.trim()).filter(Boolean);
  const map=Object.create(null);
  for(let i=1;i<lines.length;i++){
    const parts=lines[i].split(';');
    if(parts.length<3)continue;
    map[parts[2].trim().toLowerCase()]=parts[1].trim();
  }
  return map;
})();

// ─────────────────────────────────────────────────────────────────────────────
// REDUNDANCY ENGINE — rebuilt from scratch (rev 29)
//
// Approach: model each plan as a SET of capabilities it provides.
// A standalone add-on is redundant when every capability it provides
// is already covered by another assigned plan.
// Plan-vs-plan overlap is flagged when one plan is a strict subset of another.
//
// Source: Microsoft 365 service descriptions and plan comparison pages,
// verified Q2 2026. microsoft.com/en-us/microsoft-365
// ─────────────────────────────────────────────────────────────────────────────

// Capability tags used in the feature map
const C = {
  // Core productivity
  TEAMS:'teams', EXCHANGE_P1:'exo_p1', EXCHANGE_P2:'exo_p2',
  SHAREPOINT_P1:'spo_p1', SHAREPOINT_P2:'spo_p2',
  ONEDRIVE_P1:'od_p1', ONEDRIVE_P2:'od_p2',
  OFFICE_WEB:'office_web', OFFICE_DESKTOP:'office_desktop',
  // Automation / BI
  FLOW_CLOUD:'flow_cloud', FLOW_FULL:'flow_full',
  POWER_BI_FREE:'pbi_free', POWER_BI_PRO:'pbi_pro',
  // Security / Identity
  ENTRA_FREE:'entra_free', ENTRA_P1:'entra_p1', ENTRA_P2:'entra_p2',
  INTUNE:'intune', AIP_P1:'aip_p1', AIP_P2:'aip_p2',
  DEFENDER_BIZ:'defender_biz', DEFENDER_EP1:'defender_ep1', DEFENDER_EP2:'defender_ep2',
  DEFENDER_O365_P1:'mdo_p1', DEFENDER_O365_P2:'mdo_p2',
  DEFENDER_IDENTITY:'mdi',
  // Compliance
  PURVIEW_AUDIT_STD:'purview_audit_std', PURVIEW_AUDIT_PREM:'purview_audit_prem',
  PURVIEW_DLP:'purview_dlp', PURVIEW_IRM:'purview_irm',
  // Voice
  AUDIO_CONF:'audio_conf', PHONE_SYSTEM:'phone_system',
  // Device / OS
  WINDOWS_ENT:'windows_ent',
};

// Feature map: partNumber -> Set of capabilities the plan provides
// Only plans and add-ons relevant to redundancy detection are listed.
const PLAN_CAPS = {
  // ── Business plans ────────────────────────────────────────────────────────
  // Business Basic: Teams, EXO P1, SPO P1, OD1TB, Office web, Flow cloud
  'O365_BUSINESS_ESSENTIALS': new Set([C.TEAMS,C.EXCHANGE_P1,C.SHAREPOINT_P1,C.ONEDRIVE_P1,C.OFFICE_WEB,C.FLOW_CLOUD,C.ENTRA_FREE]),
  'SMB_BUSINESS_ESSENTIALS':  new Set([C.TEAMS,C.EXCHANGE_P1,C.SHAREPOINT_P1,C.ONEDRIVE_P1,C.OFFICE_WEB,C.FLOW_CLOUD,C.ENTRA_FREE]),
  // Business Standard: all of Basic + Office desktop apps
  'O365_BUSINESS_PREMIUM':    new Set([C.TEAMS,C.EXCHANGE_P1,C.SHAREPOINT_P1,C.ONEDRIVE_P1,C.OFFICE_WEB,C.OFFICE_DESKTOP,C.FLOW_CLOUD,C.ENTRA_FREE]),
  'SMB_BUSINESS_PREMIUM':     new Set([C.TEAMS,C.EXCHANGE_P1,C.SHAREPOINT_P1,C.ONEDRIVE_P1,C.OFFICE_WEB,C.OFFICE_DESKTOP,C.FLOW_CLOUD,C.ENTRA_FREE]),
  // Business Premium: Standard + Intune + Entra P1 + Defender for Business + AIP P1 + Windows Enterprise
  'SPB': new Set([C.TEAMS,C.EXCHANGE_P1,C.SHAREPOINT_P1,C.ONEDRIVE_P1,C.OFFICE_WEB,C.OFFICE_DESKTOP,C.FLOW_CLOUD,C.ENTRA_FREE,C.ENTRA_P1,C.INTUNE,C.AIP_P1,C.DEFENDER_BIZ,C.DEFENDER_O365_P1,C.WINDOWS_ENT]),

  // ── Enterprise plans ──────────────────────────────────────────────────────
  // E1: Teams, EXO P1, SPO P1, OD1TB, Office web, Flow cloud — no desktop apps
  'STANDARDPACK': new Set([C.TEAMS,C.EXCHANGE_P1,C.SHAREPOINT_P1,C.ONEDRIVE_P1,C.OFFICE_WEB,C.FLOW_CLOUD,C.ENTRA_FREE]),
  // M365 E3: E1 + Office desktop + EXO P2 + SPO P2 + Intune + Entra P1 + AIP P1 + Windows Enterprise + Flow full
  'SPE_E3': new Set([C.TEAMS,C.EXCHANGE_P1,C.EXCHANGE_P2,C.SHAREPOINT_P1,C.SHAREPOINT_P2,C.ONEDRIVE_P1,C.ONEDRIVE_P2,C.OFFICE_WEB,C.OFFICE_DESKTOP,C.FLOW_CLOUD,C.FLOW_FULL,C.ENTRA_FREE,C.ENTRA_P1,C.INTUNE,C.AIP_P1,C.WINDOWS_ENT,C.PURVIEW_AUDIT_STD,C.PURVIEW_DLP]),
  // M365 E5: E3 + Entra P2 + Defender EP2 + MDO P2 + MDI + Audio Conf + Phone System + Power BI Pro + Purview premium
  'SPE_E5': new Set([C.TEAMS,C.EXCHANGE_P1,C.EXCHANGE_P2,C.SHAREPOINT_P1,C.SHAREPOINT_P2,C.ONEDRIVE_P1,C.ONEDRIVE_P2,C.OFFICE_WEB,C.OFFICE_DESKTOP,C.FLOW_CLOUD,C.FLOW_FULL,C.ENTRA_FREE,C.ENTRA_P1,C.ENTRA_P2,C.INTUNE,C.AIP_P1,C.AIP_P2,C.WINDOWS_ENT,C.DEFENDER_EP2,C.DEFENDER_O365_P2,C.DEFENDER_IDENTITY,C.AUDIO_CONF,C.PHONE_SYSTEM,C.POWER_BI_PRO,C.PURVIEW_AUDIT_STD,C.PURVIEW_AUDIT_PREM,C.PURVIEW_DLP,C.PURVIEW_IRM]),
  // O365 E3 (without M365 extras — no Intune, no Windows rights)
  'ENTERPRISEPACK': new Set([C.TEAMS,C.EXCHANGE_P1,C.EXCHANGE_P2,C.SHAREPOINT_P1,C.SHAREPOINT_P2,C.ONEDRIVE_P1,C.ONEDRIVE_P2,C.OFFICE_WEB,C.OFFICE_DESKTOP,C.FLOW_CLOUD,C.ENTRA_FREE,C.ENTRA_P1,C.AIP_P1,C.PURVIEW_AUDIT_STD,C.PURVIEW_DLP]),
  // O365 E5
  'ENTERPRISEPREMIUM': new Set([C.TEAMS,C.EXCHANGE_P1,C.EXCHANGE_P2,C.SHAREPOINT_P1,C.SHAREPOINT_P2,C.ONEDRIVE_P1,C.ONEDRIVE_P2,C.OFFICE_WEB,C.OFFICE_DESKTOP,C.FLOW_CLOUD,C.ENTRA_FREE,C.ENTRA_P1,C.AIP_P1,C.DEFENDER_O365_P2,C.AUDIO_CONF,C.PHONE_SYSTEM,C.POWER_BI_PRO,C.PURVIEW_AUDIT_STD,C.PURVIEW_AUDIT_PREM,C.PURVIEW_DLP,C.PURVIEW_IRM]),
  // O365 E1
  'STANDARDPACK_E1': new Set([C.TEAMS,C.EXCHANGE_P1,C.SHAREPOINT_P1,C.ONEDRIVE_P1,C.OFFICE_WEB,C.FLOW_CLOUD,C.ENTRA_FREE]),

  // ── Frontline plans ───────────────────────────────────────────────────────
  // M365 F1: Teams (limited), EXO Kiosk, SPO, OD 2GB, Intune — NO Flow, no Office apps
  'M365_F1': new Set([C.TEAMS,C.SHAREPOINT_P1,C.INTUNE,C.ENTRA_FREE]),
  // M365 F3: F1 + EXO P1 + Office web + Flow cloud
  'SPE_F1': new Set([C.TEAMS,C.EXCHANGE_P1,C.SHAREPOINT_P1,C.ONEDRIVE_P1,C.OFFICE_WEB,C.FLOW_CLOUD,C.INTUNE,C.ENTRA_FREE]),

  // ── Standalone add-ons ────────────────────────────────────────────────────
  'FLOW_FREE':          new Set([C.FLOW_CLOUD]),
  'POWER_BI_STANDARD':  new Set([C.POWER_BI_FREE]),
  'POWER_BI_PRO':       new Set([C.POWER_BI_FREE,C.POWER_BI_PRO]),
  'EXCHANGESTANDARD':   new Set([C.EXCHANGE_P1]),
  'EXCHANGEENTERPRISE': new Set([C.EXCHANGE_P1,C.EXCHANGE_P2]),
  'INTUNE_A':           new Set([C.INTUNE]),
  'AAD_PREMIUM':        new Set([C.ENTRA_FREE,C.ENTRA_P1]),
  'AAD_PREMIUM_P2':     new Set([C.ENTRA_FREE,C.ENTRA_P1,C.ENTRA_P2]),
  'RIGHTSMANAGEMENT':   new Set([C.AIP_P1]),
  'MCOMEETADV':         new Set([C.AUDIO_CONF]),
  'MCOEV':              new Set([C.PHONE_SYSTEM]),
  'WIN10_PRO_ENT_SUB':  new Set([C.WINDOWS_ENT]),
  'OFFICESUBSCRIPTION': new Set([C.OFFICE_WEB,C.OFFICE_DESKTOP]),
  'IDENTITY_THREAT_PROTECTION': new Set([C.ENTRA_P2,C.DEFENDER_EP2,C.DEFENDER_O365_P2,C.DEFENDER_IDENTITY]),
};

// Helper: union of all capabilities a user has from their assigned plans
function getUserCaps(partNumbers){
  const union=new Set();
  for(const p of partNumbers){
    const caps=PLAN_CAPS[p];
    if(caps)caps.forEach(c=>union.add(c));
  }
  return union;
}

// Helper: is set A a subset of set B?
function isSubset(a,b){for(const x of a)if(!b.has(x))return false;return true;}

// ── Plan hierarchy rules (one plan makes another fully redundant) ────────────
// Each entry: { id, redundantPlan, coveredByPlan, title, desc, recommendation }
// "redundantPlan" is the lower plan whose caps are entirely covered by "coveredByPlan"
const HIERARCHY_RULES=[
  // Business plan ladder
  {
    id:'biz-basic-vs-standard',
    redundantPlans:['O365_BUSINESS_ESSENTIALS','SMB_BUSINESS_ESSENTIALS'],
    coveredByPlans:['O365_BUSINESS_PREMIUM','SMB_BUSINESS_PREMIUM','SPB'],
    title:'Microsoft 365 Business Basic + Business Standard (or Premium)',
    desc:'Business Standard and Business Premium are strict supersets of Business Basic. Every feature in Basic is already included in Standard/Premium, making the Basic license fully redundant.',
    recommendation:'Remove Microsoft 365 Business Basic — Business Standard or Premium already covers all of its features.'
  },
  {
    id:'biz-standard-vs-premium',
    redundantPlans:['O365_BUSINESS_PREMIUM','SMB_BUSINESS_PREMIUM'],
    coveredByPlans:['SPB'],
    title:'Microsoft 365 Business Standard + Business Premium',
    desc:'Business Premium is a strict superset of Business Standard. Every feature in Standard is included in Premium, plus Intune, Entra P1, Defender, and Windows Enterprise rights.',
