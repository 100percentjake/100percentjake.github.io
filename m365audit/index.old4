<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>M365 Audit Report</title>
  <style>
    :root{
      --bg:#f0f2f5; --surface:#fff; --surface2:#fafbfc;
      --border:#dde1e7; --border2:#eef0f3;
      --text:#1a1a1a; --text2:#555; --text3:#777; --text4:#aaa;
      --accent:#0078d4; --accent2:#006cbd;
      --row-hover:#f8f9fb; --chip-bg:#f0f2f5;
      --stale-bg:#fdf3f4; --stale-border:#f1a9ae; --stale-text:#c50f1f;
      --fresh-bg:#dff6dd; --fresh-text:#107c10;
      --warn-bg:#fff4ce; --warn-border:#f0d080; --warn-text:#7d5a00;
    }
    [data-theme="dark"]{
      --bg:#1a1a1e; --surface:#242428; --surface2:#2c2c32;
      --border:#3a3a42; --border2:#303038;
      --text:#e8e8ec; --text2:#aaaabc; --text3:#8888a0; --text4:#606070;
      --accent:#4da3e8; --accent2:#3d93d8;
      --row-hover:#2e2e36; --chip-bg:#2c2c38;
      --stale-bg:#2d1a1c; --stale-border:#7a3a3e; --stale-text:#f28b8b;
      --fresh-bg:#1a2d1a; --fresh-text:#6dbf6d;
      --warn-bg:#2a2000; --warn-border:#6b5200; --warn-text:#ffd966;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    body{font-family:'Segoe UI',system-ui,sans-serif;font-size:13px;color:var(--text);background:var(--bg);}
    #shell{max-width:1280px;margin:0 auto;padding:24px 16px;}
    #loading-overlay{position:fixed;inset:0;background:rgba(255,255,255,.93);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;z-index:999;font-size:14px;color:#333;}
    [data-theme="dark"] #loading-overlay{background:rgba(26,26,30,.95);color:#ccc;}
    .spinner{width:40px;height:40px;border:4px solid #e0e0e0;border-top-color:var(--accent);border-radius:50%;animation:spin .8s linear infinite;}
    @keyframes spin{to{transform:rotate(360deg);}}
    #loading-overlay.hidden{display:none;}
    #signin-screen{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;gap:20px;text-align:center;}
    #signin-screen h1{font-size:22px;font-weight:800;}
    #signin-screen p{color:var(--text2);max-width:480px;line-height:1.6;}
    #error-banner{background:var(--stale-bg);border:1px solid var(--stale-border);border-radius:8px;padding:12px 16px;color:var(--stale-text);font-size:12px;margin-top:8px;display:none;max-width:480px;}
    .btn{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border:none;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;transition:background .15s;}
    .btn-primary{background:var(--accent);color:#fff;} .btn-primary:hover{background:var(--accent2);}
    .btn-secondary{background:var(--surface);color:var(--accent);border:1px solid var(--accent);} .btn-secondary:hover{background:var(--chip-bg);}
    .btn-ghost{background:transparent;color:var(--text2);border:1px solid var(--border);} .btn-ghost:hover{background:var(--chip-bg);}
    .btn-icon{display:inline-flex;align-items:center;justify-content:center;background:var(--surface);color:var(--text2);border:1px solid var(--border);padding:8px 10px;border-radius:8px;cursor:pointer;font-size:13px;font-weight:800;line-height:1;transition:background .15s;} .btn-icon:hover{background:var(--chip-bg);}
    #report-header{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:16px 20px;margin-bottom:18px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;}
    .hdr-left{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-start;}
    .hdr-center{display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center;}
    .hdr-title{font-size:17px;font-weight:900;letter-spacing:.2px;white-space:nowrap;}
    .hdr-meta-row{display:flex;flex-direction:column;align-items:center;gap:4px;}
    .hdr-chip{display:inline-block;font-size:11px;color:var(--text2);background:var(--chip-bg);border:1px solid var(--border);border-radius:999px;padding:3px 10px;white-space:nowrap;max-width:300px;overflow:hidden;text-overflow:ellipsis;}
    .hdr-rev{font-size:10px;color:var(--text4);font-weight:700;letter-spacing:.4px;text-transform:uppercase;}
    .hdr-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end;}
    @media(max-width:860px){#report-header{grid-template-columns:1fr;justify-items:center;gap:12px;}.hdr-left,.hdr-right{justify-content:center;}}
    .tab-bar{display:flex;border-bottom:2px solid var(--border);margin-bottom:20px;}
    .tab-btn{padding:10px 22px;border:none;background:none;font-size:13px;font-weight:800;color:var(--text2);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;transition:color .15s,border-color .15s;}
    .tab-btn:hover{color:var(--accent);} .tab-btn.active{color:var(--accent);border-bottom-color:var(--accent);}
    .tab-panel{display:none;} .tab-panel.active{display:block;}
    .filter-bar{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap;}
    .filter-bar input[type=search],.filter-bar select{padding:7px 10px;border:1px solid var(--border);border-radius:8px;font-size:13px;background:var(--surface);color:var(--text);}
    .filter-bar input[type=search]{width:240px;}
    .stats-label{font-size:12px;color:var(--text2);margin-left:auto;}
    .resource-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;margin-bottom:14px;overflow:hidden;page-break-inside:avoid;break-inside:avoid;}
    .resource-card-header{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--border2);background:var(--surface2);flex-wrap:wrap;}
    .resource-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;flex-shrink:0;color:var(--text);}
    .icon-m365{background:#e9f2ff;} .icon-teams{background:#ede7f6;} .icon-shared{background:#fff3e0;} .icon-distrib{background:#e8f5e9;} .icon-security{background:#fce4ec;} .icon-mailsec{background:#fff8e1;}
    [data-theme="dark"] .icon-m365{background:#0e2d4a;} [data-theme="dark"] .icon-teams{background:#2a1a3e;} [data-theme="dark"] .icon-shared{background:#3a2200;} [data-theme="dark"] .icon-distrib{background:#0d2a0d;} [data-theme="dark"] .icon-security{background:#2d0a14;} [data-theme="dark"] .icon-mailsec{background:#2e2200;}
    .resource-title{font-size:14px;font-weight:800;} .resource-email{font-size:11px;color:var(--text2);margin-top:1px;}
    .badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.4px;}
    .badge-m365{background:#cfe4ff;color:#0047b3;} .badge-teams{background:#ede7f6;color:#4a148c;} .badge-shared{background:#fff3e0;color:#e65100;} .badge-distrib{background:#e8f5e9;color:#1b5e20;} .badge-security{background:#fce4ec;color:#880e4f;} .badge-mailsec{background:#fff8e1;color:#f57f17;}
    [data-theme="dark"] .badge-m365{background:#0e2d4a;color:#7ec4ff;} [data-theme="dark"] .badge-teams{background:#2a1a3e;color:#c4a0ff;} [data-theme="dark"] .badge-shared{background:#3a2200;color:#ffb066;} [data-theme="dark"] .badge-distrib{background:#0d2a0d;color:#6dbf6d;} [data-theme="dark"] .badge-security{background:#2d0a14;color:#ff8fa3;} [data-theme="dark"] .badge-mailsec{background:#2e2200;color:#ffd966;}
    .activity-chip{margin-left:auto;font-size:11px;color:var(--text2);background:var(--chip-bg);border-radius:6px;padding:3px 8px;white-space:nowrap;flex-shrink:0;}
    .activity-chip.stale{color:var(--stale-text);background:var(--stale-bg);} .activity-chip.recent{color:var(--fresh-text);background:var(--fresh-bg);}
    .resource-body{padding:12px 16px;}
    .person-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:6px;margin-top:8px;}
    .person-chip{display:flex;align-items:center;gap:7px;padding:5px 8px;border-radius:8px;background:var(--chip-bg);font-size:12px;border:1px solid var(--border);}
    .person-chip.owner-chip{background:#fff9e6;border-color:#f0d080;} [data-theme="dark"] .person-chip.owner-chip{background:#2e2200;border-color:#6b5200;}
    .avatar{width:24px;height:24px;border-radius:50%;color:#fff;font-size:10px;font-weight:900;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .person-info{overflow:hidden;flex:1;}
    .person-name{font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:flex;align-items:center;gap:4px;flex-wrap:wrap;}
    .person-upn{font-size:10px;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .status-flag{font-size:9px;padding:1px 5px;border-radius:5px;font-weight:900;text-transform:uppercase;flex-shrink:0;}
    .status-blocked{background:var(--stale-bg);color:var(--stale-text);border:1px solid var(--stale-border);}
    .status-shared{background:#fff3e0;color:#e65100;border:1px solid #f0c080;}
    [data-theme="dark"] .status-shared{background:#3a2200;color:#ffb066;border-color:#8a5200;}
    .status-unlicensed{background:var(--chip-bg);color:var(--text2);border:1px solid var(--border);}
    .owner-star{font-size:10px;color:#c48a00;font-weight:900;flex-shrink:0;}
    .section-label{font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.5px;color:var(--text3);margin-top:10px;margin-bottom:4px;}
    .section-label:first-child{margin-top:0;}
    .empty-note{font-size:12px;color:var(--text4);font-style:italic;}
    .users-table-wrap{overflow-x:auto;border-radius:10px;border:1px solid var(--border);background:var(--surface);}
    table{width:100%;border-collapse:collapse;font-size:12px;}
    thead th{background:var(--surface2);padding:10px 12px;text-align:left;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.35px;color:var(--text2);border-bottom:2px solid var(--border);white-space:nowrap;cursor:pointer;user-select:none;}
    thead th:hover{background:var(--chip-bg);}
    thead th .sort-arrow{margin-left:4px;font-size:10px;}
    thead th.sort-asc .sort-arrow::after{content:' ▲';color:var(--accent);}
    thead th.sort-desc .sort-arrow::after{content:' ▼';color:var(--accent);}
    tbody tr{border-bottom:1px solid var(--border2);}
    tbody tr:hover{background:var(--row-hover);}
    tbody td{padding:9px 12px;vertical-align:middle;}
    .user-name-cell{display:flex;align-items:center;gap:8px;}
    .user-name-text{font-weight:800;} .user-upn-text{font-size:11px;color:var(--text3);}
    .license-cell{display:flex;align-items:flex-start;gap:6px;flex-wrap:nowrap;}
    .license-pills{display:flex;flex-wrap:wrap;gap:4px;flex:1;}
    .license-pill{font-size:10px;padding:2px 7px;border-radius:999px;background:#e8f0fb;color:#0047b3;border:1px solid #c5d9f5;white-space:nowrap;}
    [data-theme="dark"] .license-pill{background:#0e2d4a;color:#7ec4ff;border-color:#1a4a70;}
    .license-pill.unlicensed{background:var(--chip-bg);color:var(--text2);border-color:var(--border);}
    .redundancy-btn{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:var(--stale-text);color:#fff;font-size:11px;font-weight:900;border:none;cursor:pointer;flex-shrink:0;transition:transform .1s;margin-top:1px;}
    .redundancy-btn:hover{transform:scale(1.15);}
    .redundancy-panel{display:none;background:var(--warn-bg);border:1px solid var(--warn-border);border-radius:10px;padding:14px 16px;margin:4px 0 8px;font-size:12px;line-height:1.6;}
    .redundancy-panel.open{display:block;}
    .redundancy-panel-title{font-weight:900;color:var(--warn-text);margin-bottom:8px;font-size:12px;display:flex;align-items:center;gap:6px;}
    .redundancy-issue{margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid var(--warn-border);}
    .redundancy-issue:last-child{margin-bottom:0;padding-bottom:0;border-bottom:none;}
    .redundancy-issue-title{font-weight:800;color:var(--warn-text);margin-bottom:2px;}
    .redundancy-issue-desc{color:var(--text2);font-size:11px;}
    .redundancy-recommendation{display:inline-block;margin-top:4px;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.3px;color:var(--accent);}
    .redundancy-disclaimer{margin-top:10px;font-size:10px;color:var(--text4);font-style:italic;border-top:1px solid var(--warn-border);padding-top:8px;}
    .signin-cell{white-space:nowrap;}
    .signin-cell.never{color:var(--text4);font-style:italic;} .signin-cell.stale{color:var(--stale-text);} .signin-cell.recent{color:var(--fresh-text);}
    .stale-bar-wrap{display:flex;align-items:center;gap:8px;min-width:130px;}
    .stale-bar-bg{flex:1;height:6px;background:var(--border);border-radius:999px;overflow:hidden;}
    .stale-bar-fill{height:100%;}
    .stale-low .stale-bar-fill{background:#107c10;} .stale-medium .stale-bar-fill{background:#ca5010;} .stale-high .stale-bar-fill{background:#c50f1f;}
    .stale-label{font-size:10px;font-weight:900;text-transform:uppercase;color:var(--text3);}
    .id-cell{font-family:'Cascadia Code','Consolas',monospace;font-size:10px;color:var(--text4);}
    @media print{
      body{background:#fff;color:#000;}
      #shell{padding:0;max-width:100%;}
      #report-header,.tab-bar,.filter-bar{display:none !important;}
      .tab-panel{display:block !important;}
      .resource-card{border:1px solid #ccc;margin-bottom:10px;}
      .resource-card-header{background:#f5f5f5 !important;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
      .redundancy-btn,.redundancy-panel{display:none !important;}
    }
    .hidden{display:none !important;}
    .mt8{margin-top:8px;}
  </style>
</head>
<body>
<div id="shell">
  <div id="loading-overlay"><div class="spinner"></div><div id="loading-msg">Initializing...</div></div>
  <div id="signin-screen" class="hidden">
    <h1>M365 Audit Report</h1>
    <p>Sign in as a Global Admin to audit users, groups, shared mailboxes, and export findings.</p>
    <button class="btn btn-primary" id="signin-btn">Sign in with Microsoft</button>
    <div id="error-banner"></div>
  </div>
  <div id="report-screen" class="hidden">
    <div id="report-header">
      <div class="hdr-left">
        <button class="btn btn-secondary" id="export-csv-btn">Export to Excel (CSV)</button>
        <button class="btn btn-secondary" id="export-html-btn">Save Offline Dashboard</button>
        <button class="btn btn-secondary" id="print-btn">Print</button>
      </div>
      <div class="hdr-center">
        <div class="hdr-title">M365 Audit Report</div>
        <div class="hdr-meta-row">
          <span class="hdr-chip" id="meta-user"></span>
          <span class="hdr-chip" id="meta-tenant"></span>
        </div>
        <div class="hdr-rev">rev 29</div>
      </div>
      <div class="hdr-right">
        <button class="btn-icon" id="theme-toggle" title="Toggle dark / light mode">☾</button>
        <button class="btn btn-ghost" id="signout-btn">Sign out</button>
      </div>
    </div>
    <div class="tab-bar">
      <button class="tab-btn active" data-tab="resources-panel">Resources</button>
      <button class="tab-btn" data-tab="users-panel">Users</button>
    </div>
    <div id="resources-panel" class="tab-panel active">
      <div class="filter-bar">
        <input type="search" id="res-search" placeholder="Search by name or email..."/>
        <select id="res-type-filter">
          <option value="">All types</option>
          <option value="Teams-enabled Group">Teams-enabled</option>
          <option value="M365 Group">M365 Groups</option>
          <option value="Shared Mailbox">Shared Mailboxes</option>
          <option value="Distribution List">Distribution Lists</option>
          <option value="Mail-enabled Security">Mail-enabled Security</option>
          <option value="Security Group">Security Groups</option>
        </select>
        <span id="res-stats" class="stats-label"></span>
      </div>
      <div id="cards-container"></div>
    </div>
    <div id="users-panel" class="tab-panel">
      <div class="filter-bar">
        <input type="search" id="usr-search" placeholder="Search by name, email, or ID..."/>
        <select id="usr-status-filter">
          <option value="">All users</option>
          <option value="shared-mailbox">Shared mailboxes</option>
          <option value="blocked">Sign-in blocked</option>
          <option value="unlicensed">Unlicensed</option>
          <option value="stale-high">High stale likelihood</option>
          <option value="stale-medium">Medium stale likelihood</option>
          <option value="never-signed-in">Never signed in</option>
          <option value="redundant">Has redundant licenses</option>
        </select>
        <span id="usr-stats" class="stats-label"></span>
      </div>
      <div class="users-table-wrap">
        <table id="users-table">
          <thead><tr>
            <th data-col="displayName">Name <span class="sort-arrow"></span></th>
            <th data-col="id">Object ID <span class="sort-arrow"></span></th>
            <th data-col="accountEnabled">Status <span class="sort-arrow"></span></th>
            <th data-col="licenses">Licenses <span class="sort-arrow"></span></th>
            <th data-col="lastSignIn">Last Sign-in <span class="sort-arrow"></span></th>
            <th data-col="staleness">Stale Likelihood <span class="sort-arrow"></span></th>
          </tr></thead>
          <tbody id="users-tbody"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script id="offline-payload"></script>
<script>
// ── Popup close guard ────────────────────────────────────────────────────────
(function(){
  try{
    const isPopup=window.opener&&window.opener!==window;
    const hasAuth=window.location.hash.includes('code=')||window.location.hash.includes('access_token=')||
                  window.location.hash.includes('error=')||window.location.search.includes('code=')||
                  window.location.search.includes('error=');
    if(isPopup&&hasAuth){window.close();return;}
  }catch(e){}
})();

// ── Theme prepaint ───────────────────────────────────────────────────────────
(function(){
  const saved=localStorage.getItem('m365-theme');
  const dark=saved?saved==='dark':window.matchMedia('(prefers-color-scheme: dark)').matches;
  document.documentElement.setAttribute('data-theme',dark?'dark':'light');
})();

const CLIENT_ID='d6d7b4b9-2826-4940-b6c2-5c3d9bc1b7fe';
const SCOPES=['Group.Read.All','GroupMember.Read.All','User.Read.All','Reports.Read.All','MailboxSettings.Read','Team.ReadBasic.All','AuditLog.Read.All'];

// ── SKU table ────────────────────────────────────────────────────────────────
const FULL_SKU_TABLE=`ProductName;LicensePartNumber;LicenseSKUID
APP CONNECT IW;SPZA_IW;8f0c5670-4e56-4892-b06d-91c085d7004f
Microsoft 365 Audio Conferencing;MCOMEETADV;0c266dff-15dd-4b49-8397-2bb16070ed52
AZURE ACTIVE DIRECTORY BASIC;AAD_BASIC;2b9c8e7c-319c-43a2-a2a0-48c5c6161de7
AZURE ACTIVE DIRECTORY PREMIUM P1;AAD_PREMIUM;078d2b04-f1bd-4111-bbd4-b4b1b354cef4
AZURE ACTIVE DIRECTORY PREMIUM P2;AAD_PREMIUM_P2;84a661c4-e949-4bd2-a560-ed7766fcaf2b
AZURE INFORMATION PROTECTION PLAN 1;RIGHTSMANAGEMENT;c52ea49f-fe5d-4e95-93ba-1de91d380f89
DYNAMICS 365 CUSTOMER ENGAGEMENT PLAN ENTERPRISE EDITION;DYN365_ENTERPRISE_PLAN1;ea126fc5-a19e-42e2-a731-da9d437bffcf
DYNAMICS 365 FOR CUSTOMER SERVICE ENTERPRISE EDITION;DYN365_ENTERPRISE_CUSTOMER_SERVICE;749742bf-0d37-4158-a120-33567104deeb
DYNAMICS 365 FOR FINANCIALS BUSINESS EDITION;DYN365_FINANCIALS_BUSINESS_SKU;cc13a803-544e-4464-b4e4-6d6169a138fa
DYNAMICS 365 FOR SALES AND CUSTOMER SERVICE ENTERPRISE EDITION;DYN365_ENTERPRISE_SALES_CUSTOMERSERVICE;8edc2cf8-6438-4fa9-b6e3-aa1660c640cc
DYNAMICS 365 FOR SALES ENTERPRISE EDITION;DYN365_ENTERPRISE_SALES;1e1a282c-9c54-43a2-9310-98ef728faace
DYNAMICS 365 FOR TEAM MEMBERS ENTERPRISE EDITION;DYN365_ENTERPRISE_TEAM_MEMBERS;8e7a3d30-d97d-43ab-837c-d7701cef83dc
DYNAMICS 365 UNF OPS PLAN ENT EDITION;Dynamics_365_for_Operations;ccba3cfe-71ef-423a-bd87-b6df3dce59a9
ENTERPRISE MOBILITY + SECURITY E3;EMS;efccb6f7-5641-4e0e-bd10-b4976e1bf68e
ENTERPRISE MOBILITY + SECURITY E5;EMSPREMIUM;b05e124f-c7cc-45a0-a6aa-8cf78c946968
EXCHANGE ONLINE (PLAN 1);EXCHANGESTANDARD;4b9405b0-7788-4568-add1-99614e613b69
EXCHANGE ONLINE (PLAN 2);EXCHANGEENTERPRISE;19ec0d23-8335-4cbd-94ac-6050e30712fa
EXCHANGE ONLINE ARCHIVING FOR EXCHANGE ONLINE;EXCHANGEARCHIVE_ADDON;ee02fd1b-340e-4a4b-b355-4a514e4c8943
EXCHANGE ONLINE ARCHIVING FOR EXCHANGE SERVER;EXCHANGEARCHIVE;90b5e015-709a-4b8b-b08e-3200f994494c
EXCHANGE ONLINE ESSENTIALS;EXCHANGEESSENTIALS;7fc0182e-d107-4556-8329-7caaa511197b
EXCHANGE ONLINE ESSENTIALS;EXCHANGE_S_ESSENTIALS;e8f81a67-bd96-4074-b108-cf193eb9433b
EXCHANGE ONLINE KIOSK;EXCHANGEDESKLESS;80b2d799-d2ba-4d2a-8842-fb0d0f3a4b82
EXCHANGE ONLINE POP;EXCHANGETELCO;cb0a98a8-11bc-494c-83d9-c1b1ac65327e
