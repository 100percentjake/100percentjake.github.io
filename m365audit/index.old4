function detectRedundancies(user){
  const parts=getUserPartNumbers(user);
  const issues=[];

  // 1. Check hierarchy rules (plan-vs-plan)
  for(const rule of HIERARCHY_RULES){
    const hasRedundant=rule.redundantPlans.some(p=>parts.has(p));
    const hasCoveredBy=rule.coveredByPlans.some(p=>parts.has(p));
    if(hasRedundant&&hasCoveredBy){
      issues.push({id:rule.id,title:rule.title,desc:rule.desc,recommendation:rule.recommendation});
    }
  }

  // 2. Check add-on rules
  // Build the capability union from all plans EXCEPT the add-on being tested
  for(const rule of ADDON_RULES){
    const hasAddon=rule.partNumbers.some(p=>parts.has(p));
    if(!hasAddon)continue;
    // Caps provided by everything else (excluding the add-on itself)
    const otherParts=new Set([...parts].filter(p=>!rule.partNumbers.includes(p)));
    const otherCaps=getUserCaps(otherParts);
    // Redundant if every cap the add-on provides is already in otherCaps
    if(isSubset(rule.caps,otherCaps)){
      issues.push({id:rule.id,title:rule.title,desc:rule.desc,recommendation:rule.recommendation});
    }
  }

  return issues;
}

// ── State ────────────────────────────────────────────────────────────────────
let allResources=[];
let allUsers=[];
let userSortCol='staleness';
let userSortDir='desc';

// ── Utilities ────────────────────────────────────────────────────────────────
function show(id){['signin-screen','report-screen'].forEach(s=>document.getElementById(s).classList.toggle('hidden',s!==id));}
function setLoading(on,msg){document.getElementById('loading-overlay').classList.toggle('hidden',!on);if(msg)document.getElementById('loading-msg').textContent=msg;}
function showError(msg){const b=document.getElementById('error-banner');b.style.display='block';b.textContent='Error: '+msg;}
function esc(s){return String(s||'').replace(/&/g,'&').replace(/</g,'<').replace(/>/g,'>').replace(/"/g,'"');}
function daysSince(d){if(!d)return null;const ms=Date.now()-new Date(d).getTime();return isNaN(ms)?null:Math.floor(ms/86400000);}
function initials(n){if(!n)return'?';const p=n.trim().split(/\s+/);return p.length===1?p[0][0].toUpperCase():(p[0][0]+p[p.length-1][0]).toUpperCase();}
function avatarColor(n){const pal=['#0078d4','#107c10','#c50f1f','#8764b8','#ca5010','#038387'];let h=0;for(const c of(n||''))h=(h*31+c.charCodeAt(0))&0xffffffff;return pal[Math.abs(h)%pal.length];}
function csvEsc(s){return'"'+String(s||'').replace(/"/g,'""')+'"';}
function downloadFile(content,filename,type){const b=new Blob([content],{type}),u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download=filename;a.click();URL.revokeObjectURL(u);}
function resolveLicenseNameFromSkuId(skuId){if(!skuId)return'Unknown SKU';return SKU_GUID_TO_NAME[String(skuId).trim().toLowerCase()]||`Unknown SKU (${skuId})`;}
function getUserPartNumbers(user){const set=new Set();for(const l of(user.assignedLicenses||[])){const part=GUID_TO_PART[String(l.skuId||'').trim().toLowerCase()];if(part)set.add(part);}return set;}
function bakeUserLicenses(u){u._licenseNames=(u.assignedLicenses||[]).map(l=>resolveLicenseNameFromSkuId(l.skuId));u._redundancies=detectRedundancies(u);return u;}

function inferSharedMailbox(u){
  return u.accountEnabled===false&&(u.assignedLicenses||[]).length===0&&(u.userType||'Member')==='Member';
}

function stalenessScore(user){
  if(user._isSharedMailbox)return{score:0,tier:'low',label:'N/A'};
  let score=0;
  if(user.accountEnabled===false)score+=35;
  if(!(user.assignedLicenses&&user.assignedLicenses.length>0))score+=20;
  const ls=user.signInActivity?.lastSuccessfulSignInDateTime||user.signInActivity?.lastSignInDateTime;
  if(!ls)score+=30;
  else{const d=daysSince(ls);if(d>180)score+=25;else if(d>90)score+=15;else if(d>30)score+=5;}
  score=Math.min(score,100);
  return{score,tier:score>=60?'high':score>=30?'medium':'low',label:score>=60?'High':score>=30?'Medium':'Low'};
}

// ── Resource rendering ───────────────────────────────────────────────────────
function typeStyle(t){return({'Teams-enabled Group':{badge:'badge-teams',icon:'icon-teams',txt:'T'},'M365 Group':{badge:'badge-m365',icon:'icon-m365',txt:'M'},'Shared Mailbox':{badge:'badge-shared',icon:'icon-shared',txt:'S'},'Distribution List':{badge:'badge-distrib',icon:'icon-distrib',txt:'D'},'Mail-enabled Security':{badge:'badge-mailsec',icon:'icon-mailsec',txt:'MS'},'Security Group':{badge:'badge-security',icon:'icon-security',txt:'SG'}})[t]||{badge:'badge-m365',icon:'icon-m365',txt:'G'};}
function activityChipHtml(la){const d=daysSince(la);if(d===null)return'<span class="activity-chip">No activity data</span>';const cls=d>90?'stale':d<14?'recent':'';return`<span class="activity-chip ${cls}">${d===0?'Active today':d===1?'Active yesterday':`Last active ${d}d ago`}</span>`;}
function personChipHtml(p,isOwner){
  const upn=p.userPrincipalName||p.mail||'';let flags='';
  if(p.accountEnabled===false)flags+='<span class="status-flag status-blocked">Blocked</span>';
  if(p.assignedLicenses&&p.assignedLicenses.length===0)flags+='<span class="status-flag status-unlicensed">Unlicensed</span>';
  return`<div class="person-chip${isOwner?' owner-chip':''}"><div class="avatar" style="background:${avatarColor(p.displayName)}">${initials(p.displayName)}</div><div class="person-info"><div class="person-name">${esc(p.displayName||upn)} ${flags}</div><div class="person-upn">${esc(upn)}</div></div>${isOwner?'<span class="owner-star">(Owner)</span>':''}</div>`;
}
function renderCard(res){
  const s=typeStyle(res.type),oids=new Set((res.owners||[]).map(o=>o.id)),nom=(res.members||[]).filter(m=>!oids.has(m.id));
  const oh=(res.owners||[]).length?res.owners.map(p=>personChipHtml(p,true)).join(''):'<span class="empty-note">No owners listed</span>';
  const mh=nom.length?nom.map(p=>personChipHtml(p,false)).join(''):res.delegatesNote?'<span class="empty-note">Full Access delegates not shown by Graph API. Check Exchange Admin Center.</span>':'<span class="empty-note">No members</span>';
  return`<div class="resource-card"><div class="resource-card-header"><div class="resource-icon ${s.icon}">${s.txt}</div><div><div class="resource-title">${esc(res.displayName)}</div><div class="resource-email">${esc(res.mail||'')}${res.description?' - '+esc(res.description.slice(0,80)):''}</div></div><span class="badge ${s.badge}">${esc(res.type)}</span><span style="font-size:11px;color:var(--text3);">(${(res.members||[]).length})</span>${activityChipHtml(res.lastActivity)}</div><div class="resource-body"><div class="section-label">Owners</div><div class="person-grid">${oh}</div><div class="section-label mt8">Members</div><div class="person-grid">${mh}</div></div></div>`;
}
function renderResources(){
  const search=(document.getElementById('res-search').value||'').toLowerCase();
  const tf=document.getElementById('res-type-filter').value;
  const typeOrder=['Teams-enabled Group','M365 Group','Shared Mailbox','Distribution List','Mail-enabled Security','Security Group','Group'];
  const filtered=allResources.filter(r=>(!tf||r.type===tf)&&(!search||(r.displayName||'').toLowerCase().includes(search)||(r.mail||'').toLowerCase().includes(search))).sort((a,b)=>{const d=typeOrder.indexOf(a.type)-typeOrder.indexOf(b.type);return d?d:(a.displayName||'').localeCompare(b.displayName||'');});
  document.getElementById('cards-container').innerHTML=filtered.length?filtered.map(renderCard).join(''):'<p style="color:var(--text4);text-align:center;padding:40px;">No resources match your filter.</p>';
  document.getElementById('res-stats').textContent=`Showing ${filtered.length} of ${allResources.length} resources`;
}

// ── User rendering ───────────────────────────────────────────────────────────
function formatSignInDate(user){
  const dt=user.signInActivity?.lastSuccessfulSignInDateTime||user.signInActivity?.lastSignInDateTime;
  if(!dt)return{label:'Never',cls:'never',iso:null};
  const d=daysSince(dt),label=new Date(dt).toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'});
  return{label:`${label} (${d}d ago)`,cls:d>90?'stale':d<14?'recent':'',iso:dt};
}
function buildRedundancyPanelHtml(redundancies,userId){
  if(!redundancies||redundancies.length===0)return'';
  const issuesHtml=redundancies.map(r=>`
    <div class="redundancy-issue">
      <div class="redundancy-issue-title">${esc(r.title)}</div>
      <div class="redundancy-issue-desc">${esc(r.desc)}</div>
      <span class="redundancy-recommendation">➔ ${esc(r.recommendation)}</span>
    </div>`).join('');
  return`<div class="redundancy-panel" id="rp-${esc(userId)}">
    <div class="redundancy-panel-title">⚠ License Redundancy Detected (${redundancies.length} issue${redundancies.length>1?'s':''})</div>
    ${issuesHtml}
    <div class="redundancy-disclaimer">ⓘ License capability data is accurate as of Q2 2026 per Microsoft published service descriptions. Verify at microsoft.com/licensing before making changes.</div>
  </div>`;
}
function renderUserRow(user){
  const si=formatSignInDate(user),st=stalenessScore(user),upn=user.userPrincipalName||user.mail||'';
  const redundancies=user._redundancies||detectRedundancies(user);
  const hasRedundancy=redundancies.length>0;
  const isShared=!!user._isSharedMailbox;
  let statusHtml;
  if(isShared) statusHtml='<span class="status-flag status-shared">Shared Mailbox</span>';
  else if(user.accountEnabled===false) statusHtml='<span class="status-flag status-blocked">Blocked</span>';
  else statusHtml='<span style="color:var(--fresh-text);font-weight:900;">Active</span>';
  const licNames=user._licenseNames||[];
  const licPills=licNames.length===0?'<span class="license-pill unlicensed">Unlicensed</span>':licNames.map(n=>`<span class="license-pill" title="${esc(n)}">${esc(n)}</span>`).join('');
  const redundancyBtn=hasRedundancy?`<button class="redundancy-btn" data-uid="${esc(user.id)}" title="Click to see redundant license details">!</button>`:'';
  const panelHtml=hasRedundancy?buildRedundancyPanelHtml(redundancies,user.id):'';
  const staleCell=isShared?'<span style="color:var(--text4);font-size:11px;">N/A</span>':`<div class="stale-bar-wrap stale-${st.tier}"><div class="stale-bar-bg"><div class="stale-bar-fill" style="width:${st.score}%"></div></div><span class="stale-label">${st.label}</span></div>`;
  return`<tr data-uid="${esc(user.id)}"${isShared?' style="opacity:.82;"':''}>
    <td><div class="user-name-cell">
      <div class="avatar" style="background:${isShared?'#8a6a00':avatarColor(user.displayName)}">${isShared?'✉':initials(user.displayName)}</div>
      <div><div class="user-name-text">${esc(user.displayName||upn)}</div><div class="user-upn-text">${esc(upn)}</div></div>
    </div></td>
    <td class="id-cell" title="${esc(user.id)}">${esc(user.id)}</td>
    <td>${statusHtml}</td>
    <td><div class="license-cell"><div class="license-pills">${licPills}</div>${redundancyBtn}</div></td>
    <td class="signin-cell ${si.cls}">${esc(si.label)}</td>
    <td>${staleCell}</td>
  </tr>${hasRedundancy?`<tr class="redundancy-row" data-uid="${esc(user.id)}"><td colspan="6" style="padding:0 12px;">${panelHtml}</td></tr>`:''}`;
}
function renderUsers(){
  const search=(document.getElementById('usr-search').value||'').toLowerCase();
  const sf=document.getElementById('usr-status-filter').value;
  let filtered=allUsers.filter(u=>{
    const upn=(u.userPrincipalName||u.mail||'').toLowerCase();
    if(search&&!(u.displayName||'').toLowerCase().includes(search)&&!upn.includes(search)&&!(u.id||'').toLowerCase().includes(search))return false;
    if(sf==='shared-mailbox'&&!u._isSharedMailbox)return false;
    if(sf==='blocked'&&(u.accountEnabled!==false||u._isSharedMailbox))return false;
    if(sf==='unlicensed'&&(u.assignedLicenses||[]).length>0)return false;
    if(sf==='never-signed-in'&&(u.signInActivity?.lastSignInDateTime||u.signInActivity?.lastSuccessfulSignInDateTime))return false;
    if(sf==='stale-high'&&stalenessScore(u).tier!=='high')return false;
    if(sf==='stale-medium'&&stalenessScore(u).tier!=='medium')return false;
    if(sf==='redundant'&&(u._redundancies||detectRedundancies(u)).length===0)return false;
    return true;
  });
  filtered.sort((a,b)=>{
    let av,bv;
    if(userSortCol==='displayName'){av=(a.displayName||'').toLowerCase();bv=(b.displayName||'').toLowerCase();}
    else if(userSortCol==='id'){av=a.id||'';bv=b.id||'';}
    else if(userSortCol==='accountEnabled'){av=a.accountEnabled===false?0:1;bv=b.accountEnabled===false?0:1;}
    else if(userSortCol==='licenses'){av=(a.assignedLicenses||[]).length;bv=(b.assignedLicenses||[]).length;}
    else if(userSortCol==='lastSignIn'){const da=a.signInActivity?.lastSuccessfulSignInDateTime||a.signInActivity?.lastSignInDateTime,db=b.signInActivity?.lastSuccessfulSignInDateTime||b.signInActivity?.lastSignInDateTime;av=da?new Date(da).getTime():0;bv=db?new Date(db).getTime():0;}
    else if(userSortCol==='staleness'){av=stalenessScore(a).score;bv=stalenessScore(b).score;}
    if(av<bv)return userSortDir==='asc'?-1:1;if(av>bv)return userSortDir==='asc'?1:-1;return 0;
  });
  document.getElementById('users-tbody').innerHTML=filtered.length?filtered.map(renderUserRow).join(''):'<tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text4);">No users match your filter.</td></tr>';
  document.getElementById('usr-stats').textContent=`Showing ${filtered.length} of ${allUsers.length} users`;
  document.querySelectorAll('#users-table thead th').forEach(th=>{th.classList.remove('sort-asc','sort-desc');if(th.dataset.col===userSortCol)th.classList.add(userSortDir==='asc'?'sort-asc':'sort-desc');});
  document.querySelectorAll('.redundancy-btn').forEach(btn=>{
    btn.addEventListener('click',e=>{
      e.stopPropagation();
      const uid=btn.dataset.uid;
      const panel=document.getElementById('rp-'+uid);
      if(panel){const isOpen=panel.classList.toggle('open');btn.style.background=isOpen?'var(--warn-text)':'var(--stale-text)';}
    });
  });
}

// ── Boot ─────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded',()=>{
  const themeBtn=document.getElementById('theme-toggle');
  function updateThemeIcon(){const dark=document.documentElement.getAttribute('data-theme')==='dark';themeBtn.innerHTML=dark?'☀':'☾';themeBtn.title=dark?'Switch to light mode':'Switch to dark mode';}
  updateThemeIcon();
  themeBtn.addEventListener('click',()=>{const next=document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark';document.documentElement.setAttribute('data-theme',next);localStorage.setItem('m365-theme',next);updateThemeIcon();});
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',e=>{if(!localStorage.getItem('m365-theme')){document.documentElement.setAttribute('data-theme',e.matches?'dark':'light');updateThemeIcon();}});
  document.querySelectorAll('.tab-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(btn.dataset.tab).classList.add('active');
    });
  });
  document.querySelectorAll('#users-table thead th').forEach(th=>{
    th.addEventListener('click',()=>{
      if(th.dataset.col===userSortCol)userSortDir=userSortDir==='asc'?'desc':'asc';
      else{userSortCol=th.dataset.col;userSortDir=th.dataset.col==='staleness'||th.dataset.col==='lastSignIn'?'desc':'asc';}
      renderUsers();
    });
  });
  document.getElementById('res-search').addEventListener('input',renderResources);
  document.getElementById('res-type-filter').addEventListener('change',renderResources);
  document.getElementById('usr-search').addEventListener('input',renderUsers);
  document.getElementById('usr-status-filter').addEventListener('change',renderUsers);
  document.getElementById('print-btn').addEventListener('click',()=>window.print());

  document.getElementById('export-csv-btn').addEventListener('click',()=>{
    const prefix=(document.getElementById('meta-tenant').textContent||'report').replace(/[^a-z0-9]/gi,'_');
    const date=new Date().toISOString().slice(0,10);
    let uCsv='\uFEFFName,Email/UPN,Object ID,Type,Status,Licenses,Redundant Licenses,Last Sign-in,Stale Likelihood\n';
    allUsers.forEach(u=>{
      const upn=u.userPrincipalName||u.mail||'';
      const type=u._isSharedMailbox?'Shared Mailbox':'User';
      const status=u._isSharedMailbox?'Shared Mailbox':u.accountEnabled===false?'Blocked':'Active';
      const lics=(u._licenseNames||[]).length?u._licenseNames.join('; '):'Unlicensed';
      const redundancies=(u._redundancies||detectRedundancies(u)).map(r=>r.title).join('; ')||'None';
      const ls=u.signInActivity?.lastSuccessfulSignInDateTime||u.signInActivity?.lastSignInDateTime||'Never';
      const stale=u._isSharedMailbox?'N/A':stalenessScore(u).label;
      uCsv+=[u.displayName,upn,u.id,type,status,lics,redundancies,ls,stale].map(csvEsc).join(',')+'\n';
    });
    let rCsv='\uFEFFName,Email,Type,Total Members,Owners,Description,Last Activity\n';
    allResources.forEach(r=>{
      const owners=(r.owners||[]).map(o=>o.displayName||o.userPrincipalName).join('; ');
      rCsv+=[r.displayName,r.mail,r.type,(r.members||[]).length,owners,r.description,r.lastActivity||'No data'].map(csvEsc).join(',')+'\n';
    });
    downloadFile(uCsv,`M365-Users-${prefix}-${date}.csv`,'text/csv;charset=utf-8;');
    downloadFile(rCsv,`M365-Resources-${prefix}-${date}.csv`,'text/csv;charset=utf-8;');
  });

  document.getElementById('export-html-btn').addEventListener('click',()=>{
    const payload={account:document.getElementById('meta-user').textContent,tenantId:document.getElementById('meta-tenant').textContent,allResources,allUsers};
    const tag=document.getElementById('offline-payload');
    tag.textContent='window.OFFLINE_DATA='+JSON.stringify(payload)+';';
    const html='<!DOCTYPE html>\n'+document.documentElement.outerHTML;
    tag.textContent='';
    const prefix=(document.getElementById('meta-tenant').textContent||'report').replace(/[^a-z0-9]/gi,'_');
    const date=new Date().toISOString().slice(0,10);
    downloadFile(html,`M365-Dashboard-${prefix}-${date}.html`,'text/html;charset=utf-8;');
  });

  if(window.OFFLINE_DATA){
    allResources=window.OFFLINE_DATA.allResources||[];
    allUsers=(window.OFFLINE_DATA.allUsers||[]).map(u=>{u._redundancies=detectRedundancies(u);return u;});
    document.getElementById('meta-user').textContent=window.OFFLINE_DATA.account||'Offline';
    document.getElementById('meta-tenant').textContent=window.OFFLINE_DATA.tenantId||'Offline';
    document.getElementById('signout-btn').style.display='none';
    document.getElementById('export-html-btn').style.display='none';
    setLoading(false);show('report-screen');renderResources();renderUsers();
    return;
  }

  const ms=document.createElement('script');
  ms.src='https://alcdn.msauth.net/browser/2.35.0/js/msal-browser.min.js';
  ms.onload=()=>initMsal();
  ms.onerror=()=>{setLoading(false);show('signin-screen');showError('Failed to load authentication library.');};
  document.head.appendChild(ms);
});

// ── MSAL + Graph ─────────────────────────────────────────────────────────────
function initMsal(){
  const msalInstance=new msal.PublicClientApplication({
    auth:{clientId:CLIENT_ID,authority:'https://login.microsoftonline.com/organizations',redirectUri:window.location.href.split('?')[0].split('#')[0],navigateToLoginRequestUrl:false},
    cache:{cacheLocation:'sessionStorage'},
    system:{allowNativeBroker:false,windowHashTimeout:9000,iframeHashTimeout:9000,loadFrameTimeout:9000}
  });

  async function getToken(account){try{return(await msalInstance.acquireTokenSilent({scopes:SCOPES,account})).accessToken;}catch{return(await msalInstance.acquireTokenPopup({scopes:SCOPES,account})).accessToken;}}
  async function gGet(token,url,h={}){const r=await fetch(url,{headers:{Authorization:'Bearer '+token,...h}});if(!r.ok)throw new Error('Graph '+r.status);return r.json();}
  async function gAll(token,url,h={}){let res=[],next=url;while(next){const r=await fetch(next,{headers:{Authorization:'Bearer '+token,...h}});if(!r.ok)throw new Error('Graph '+r.status);const p=await r.json();if(p.value)res=res.concat(p.value);next=p['@odata.nextLink']||null;}return res;}
  async function gCsv(token,url){const r=await fetch(url,{headers:{Authorization:'Bearer '+token}});if(!r.ok)return null;return r.text();}

  async function runReport(account){
    setLoading(true,'Signing in...');
    document.getElementById('meta-user').textContent=account.username;
    document.getElementById('meta-tenant').textContent='Tenant: '+account.tenantId;
    document.getElementById('signout-btn').style.display='inline-flex';
    let token;
    try{token=await getToken(account);}
    catch(e){setLoading(false);show('signin-screen');showError('Failed to acquire token: '+(e.message||e));return;}
    try{
      setLoading(true,'Fetching groups...');
      const groups=await gAll(token,'https://graph.microsoft.com/v1.0/groups?$select=id,displayName,mail,mailEnabled,securityEnabled,groupTypes,description,createdDateTime&$top=999');
      setLoading(true,'Identifying Teams...');
      const tg=await gAll(token,"https://graph.microsoft.com/v1.0/groups?$filter=resourceProvisioningOptions/Any(x:x eq 'Team')&$select=id&$top=999");
      const teamsSet=new Set(tg.map(t=>t.id));
      setLoading(true,'Fetching activity...');
      const activityMap={};
      try{
        const csv=await gCsv(token,"https://graph.microsoft.com/v1.0/reports/getOffice365GroupsActivityDetail(period='D180')");
        if(csv){
          const lines=csv.split('\n'),hdr=lines[0].split(',');
          const ii=hdr.findIndex(h=>h.replace(/"/g,'').trim()==='Group Id');
          const li=hdr.findIndex(h=>h.replace(/"/g,'').trim()==='Last Activity Date');
          for(let i=1;i<lines.length;i++){const c=lines[i].split(','),gid=(c[ii]||'').replace(/"/g,'').trim(),lad=(c[li]||'').replace(/"/g,'').trim();if(gid)activityMap[gid]=lad||null;}
        }
      }catch{}
      const resources=[];
      for(let i=0;i<groups.length;i++){
        const g=groups[i];setLoading(true,`Fetching members (${i+1}/${groups.length})...`);
        let members=[],owners=[];
        try{members=await gAll(token,`https://graph.microsoft.com/v1.0/groups/${g.id}/members/microsoft.graph.user?$select=id,displayName,userPrincipalName,mail,accountEnabled,assignedLicenses&$top=999`);}catch{}
        try{owners=await gAll(token,`https://graph.microsoft.com/v1.0/groups/${g.id}/owners/microsoft.graph.user?$select=id,displayName,userPrincipalName,mail,accountEnabled,assignedLicenses&$top=999`);}catch{}
        const type=teamsSet.has(g.id)?'Teams-enabled Group':(g.groupTypes||[]).includes('Unified')?'M365 Group':(!!g.mailEnabled&&!!g.securityEnabled)?'Mail-enabled Security':!!g.mailEnabled?'Distribution List':!!g.securityEnabled?'Security Group':'Group';
        resources.push({id:g.id,displayName:g.displayName,mail:g.mail,description:g.description,type,lastActivity:activityMap[g.id]??null,members,owners});
      }
      setLoading(true,'Fetching users & inferring shared mailboxes...');
      let rawUsers=[];
      try{rawUsers=await gAll(token,'https://graph.microsoft.com/v1.0/users?$select=id,displayName,userPrincipalName,mail,accountEnabled,assignedLicenses,signInActivity,userType&$top=999',{'ConsistencyLevel':'eventual'});}
      catch{try{rawUsers=await gAll(token,'https://graph.microsoft.com/v1.0/users?$select=id,displayName,userPrincipalName,mail,accountEnabled,assignedLicenses,userType&$top=999');}catch(e){showError('Failed to fetch users: '+(e.message||e));}}
      rawUsers.forEach(u=>{
        if(inferSharedMailbox(u)){
          u._isSharedMailbox=true;
          resources.push({id:u.id,displayName:u.displayName,mail:u.mail||u.userPrincipalName,description:'Shared Mailbox (inferred)',type:'Shared Mailbox',lastActivity:null,members:[],owners:[],delegatesNote:true});
        }
      });
      allResources=resources;
      allUsers=rawUsers.map(bakeUserLicenses);
      setLoading(false);show('report-screen');renderResources();renderUsers();
    }catch(e){setLoading(false);show('signin-screen');showError('Report failed: '+(e.message||e));}
  }

  async function init(){
    if(window.opener&&window.opener!==window)return;
    try{await msalInstance.handleRedirectPromise();}catch(e){console.warn('handleRedirectPromise:',e);}
    const accts=msalInstance.getAllAccounts();
    if(accts.length>0){await runReport(accts[0]);return;}
    setLoading(false);show('signin-screen');
  }

  document.getElementById('signin-btn').addEventListener('click',async()=>{
    const btn=document.getElementById('signin-btn');
    btn.disabled=true;btn.textContent='Signing in...';
    try{
      const result=await msalInstance.loginPopup({scopes:SCOPES,prompt:'select_account'});
      if(result&&result.account)await runReport(result.account);
      else throw new Error('No account returned from login.');
    }catch(err){
      btn.disabled=false;btn.textContent='Sign in with Microsoft';
      if(err.errorCode!=='user_cancelled')showError(err.message||'Sign-in failed.');
    }
  });

  document.getElementById('signout-btn').addEventListener('click',()=>{
    msalInstance.logoutPopup({postLogoutRedirectUri:window.location.href.split('?')[0].split('#')[0]})
      .then(()=>{allUsers=[];allResources=[];show('signin-screen');})
      .catch(()=>{msalInstance.clearCache();allUsers=[];allResources=[];show('signin-screen');});
  });

  init().catch(e=>{setLoading(false);show('signin-screen');showError(e.message||'Init failed');});
}
</script>
</body>
</html>