  },
  // Business vs Enterprise
  {
    id:'biz-vs-e3',
    redundantPlans:['O365_BUSINESS_ESSENTIALS','SMB_BUSINESS_ESSENTIALS','O365_BUSINESS_PREMIUM','SMB_BUSINESS_PREMIUM','SPB'],
    coveredByPlans:['SPE_E3','SPE_E5'],
    title:'Microsoft 365 Business plan + Microsoft 365 E3/E5',
    desc:'Microsoft 365 E3 and E5 are enterprise plans that supersede all Business-tier plans in every capability. Holding a Business plan alongside E3 or E5 is redundant.',
    recommendation:'Remove the Business-tier license — the user\'s E3 or E5 plan covers all Business plan features and more.'
  },
  // E1 vs E3/E5
  {
    id:'e1-vs-e3',
    redundantPlans:['STANDARDPACK'],
    coveredByPlans:['SPE_E3','SPE_E5','ENTERPRISEPACK','ENTERPRISEPREMIUM'],
    title:'Office 365 E1 + Microsoft 365 E3/E5 (or Office 365 E3/E5)',
    desc:'E3 and E5 are strict supersets of E1. Every feature in E1 is already included in E3/E5.',
    recommendation:'Remove Office 365 E1 — E3 or E5 already covers all of its features.'
  },
  // E3 vs E5
  {
    id:'e3-vs-e5',
    redundantPlans:['SPE_E3','ENTERPRISEPACK'],
    coveredByPlans:['SPE_E5','ENTERPRISEPREMIUM'],
    title:'Microsoft 365 E3 + Microsoft 365 E5',
    desc:'E5 is a strict superset of E3. Every feature in E3 is included in E5, plus Defender, Purview premium, Phone System, Audio Conferencing, and Power BI Pro.',
    recommendation:'Remove Microsoft 365 E3 — E5 already covers all of its features.'
  },
  // F1 vs F3
  {
    id:'f1-vs-f3',
    redundantPlans:['M365_F1'],
    coveredByPlans:['SPE_F1'],
    title:'Microsoft 365 F1 + Microsoft 365 F3',
    desc:'F3 is a superset of F1, adding Exchange Online, OneDrive, Office web apps, and Power Automate. The F1 license is redundant.',
    recommendation:'Remove Microsoft 365 F1 — F3 already covers all of its features.'
  },
];

// ── Add-on redundancy rules ──────────────────────────────────────────────────
// Fired when the add-on's capability set is entirely covered by the union of
// the user's other assigned plans.
const ADDON_RULES=[
  {
    id:'flow-free',
    partNumbers:['FLOW_FREE'],
    caps:new Set([C.FLOW_CLOUD]),
    title:'Microsoft Flow Free — superseded by included Power Automate',
    desc:'The assigned plan already includes Power Automate for Microsoft 365 (cloud flows), which provides everything Flow Free offers. The standalone Flow Free license is redundant.',
    recommendation:'Remove the Microsoft Flow Free license.'
  },
  {
    id:'pbi-free',
    partNumbers:['POWER_BI_STANDARD'],
    caps:new Set([C.POWER_BI_FREE]),
    title:'Power BI (Free) — superseded by Power BI Pro',
    desc:'Power BI Pro is a strict superset of Power BI Free. The free license provides no additional capability to a user who already has Pro.',
    recommendation:'Remove the Power BI (Free) license.'
  },
